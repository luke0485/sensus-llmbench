{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SENSUS trajectory item",
  "type": "object",
  "required": [
    "id", "type", "category", "turn_type", "version", "bank_version",
    "scene", "history", "user", "surface", "turn_key", "underlying",
    "reply_must", "reply_must_not", "reference", "exemplar_1", "exemplar_0"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^(E|V)[0-9]{2}$" },
    "type": { "enum": ["text", "image"] },
    "modality": { "enum": ["text", "image"] },
    "category": { "const": "trajectory" },
    "turn_type": {
      "enum": [
        "self_mock_to_doubt", "complain_to_protect", "permission_to_decision",
        "pride_to_guilt", "anger_to_fear", "enthusiasm_to_deflation",
        "ask_to_shame", "calm_to_irony_to_anger", "care_to_control",
        "apology_to_grievance"
      ]
    },
    "version": { "type": "string" },
    "bank_version": { "type": "string", "const": "release" },
    "status": { "enum": ["stable", "provisional"] },
    "scene": { "type": "string", "minLength": 4 },
    "history": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "user": { "type": "string", "minLength": 2 },
    "image": { "type": "string" },
    "surface": { "type": "string", "minLength": 4 },
    "turn_key": { "type": "string", "minLength": 8 },
    "underlying": { "type": "string", "minLength": 8 },
    "reply_must": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
    "reply_must_not": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
    "reference": { "type": "string", "minLength": 8 },
    "exemplar_1": { "type": "string", "minLength": 4 },
    "exemplar_0": { "type": "string", "minLength": 4 }
  },
  "additionalProperties": true
}
